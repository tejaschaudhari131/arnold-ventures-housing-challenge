# Stateframe environment file. Safe to commit.
# Copy to `.env` (git-ignored) only if you need to override a value.
# No variable is required for setup, tests, or the offline simulator.

# Optional U.S. Census API key. Live ACS table downloads in scripts/get_data.sh
# use the Census summary-file HTTPS archive and do not need a key. A key is
# used only if you point acquisition at the Census microdata API.
CENSUS_API_KEY=

# Directory for live-refresh caches. The committed benchmark the app runs on
# is data/sample/fixtures.json. A successful get_data.sh writes here.
DATA_DIR=./data

# Override the fixture file (absolute or relative path). Leave unset to use
# the committed sample benchmark, which is what tests and the docs match.
# STATEFRAME_FIXTURES=./data/cache/fixtures.json

# Web server bind. Defaults keep the app on localhost.
STATEFRAME_HOST=127.0.0.1
STATEFRAME_PORT=8080
